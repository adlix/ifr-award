{% extends 'layout.html.twig' %}

{% block title %}Settings · IFR Robotics Awards{% endblock %}

{% block hero %}
<section class="hero hero-compact">
    <div class="hero-inner">
        <p class="eyebrow">Administration</p>
        <h1>Settings</h1>
        <p>Manage submission dates and the application form.</p>
    </div>
</section>
{% endblock %}

{% block content %}
<div class="content-shell">
    {% if success %}<p class="notice">{{ success }}</p>{% endif %}

    <section class="card admin-panel">
        <p class="eyebrow">Application form settings</p>
        <h2>Manage submission dates and attendance confirmation</h2>
        <p>The start and end dates are inclusive. Outside this period the public form remains visible with a closed notice, but cannot be submitted.</p>

        {% if errors %}
            <div class="form-errors" role="alert">
                <ul>
                    {% for error in errors %}<li>{{ error }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <form action="{{ site_url('admin/settings') }}" method="post">
            {{ csrf_field() }}
            <div class="field-grid">
                <div class="field">
                    <label for="starts-on">Start date <span class="required">*</span></label>
                    <input class="{{ errors.starts_on is defined ? 'invalid' : '' }}" type="date" id="starts-on" name="starts_on" value="{{ values.starts_on }}" required>
                    {% if errors.starts_on is defined %}<p class="field-error">{{ errors.starts_on }}</p>{% endif %}
                </div>
                <div class="field">
                    <label for="ends-on">End date <span class="required">*</span></label>
                    <input class="{{ errors.ends_on is defined ? 'invalid' : '' }}" type="date" id="ends-on" name="ends_on" value="{{ values.ends_on }}" required>
                    {% if errors.ends_on is defined %}<p class="field-error">{{ errors.ends_on }}</p>{% endif %}
                </div>
            </div>
            <div class="field">
                <label for="attendance-confirmation-text">Attendance confirmation text <span class="required">*</span></label>
                <textarea class="{{ errors.attendance_confirmation_text is defined ? 'invalid' : '' }}" id="attendance-confirmation-text" name="attendance_confirmation_text" maxlength="2000" required aria-describedby="attendance-confirmation-hint">{{ values.attendance_confirmation_text }}</textarea>
                <p class="field-hint" id="attendance-confirmation-hint">Enter the complete text for the attendance checkbox, including the award session and ceremony dates. This text also appears in the confirmation email. Maximum 2000 characters.</p>
                {% if errors.attendance_confirmation_text is defined %}<p class="field-error">{{ errors.attendance_confirmation_text }}</p>{% endif %}
            </div>
            <div class="submit-row">
                <p>Changes take effect immediately for the public nomination form.</p>
                <button class="button" type="submit">Save form settings</button>
            </div>
        </form>
    </section>
</div>
{% endblock %}
