{% extends 'layout.html.twig' %}

{% block title %}Nomination review · IFR Robotics Awards{% endblock %}

{% block hero %}
<section class="hero hero-compact">
    <div class="hero-inner">
        <p class="eyebrow">Jury & administration</p>
        <h1>Nomination review</h1>
        <p>Review nominations for an award cycle and open each complete submission with its supporting documents.</p>
    </div>
</section>
{% endblock %}

{% block content %}
<div class="content-shell review-shell">
    <section class="review-toolbar" aria-label="Award cycle filter">
        <div>
            <p class="eyebrow">Award cycle</p>
            <h2>Submitted nominations</h2>
        </div>
        {% if periods %}
            <form method="get" action="{{ site_url('admin/nominations') }}" class="period-filter">
                <label for="period">Show award cycle
                    <select id="period" name="period" onchange="this.form.submit()">
                        {% for period in periods %}
                            <option value="{{ period }}" {{ period == selectedPeriod ? 'selected' : '' }}>{{ period }}</option>
                        {% endfor %}
                    </select>
                </label>
                <button class="button secondary filter-submit" type="submit">Show</button>
            </form>
        {% endif %}
    </section>

    {% if periods %}
        <p class="review-summary"><strong>{{ nominations|length }}</strong> nomination{{ nominations|length == 1 ? '' : 's' }} received in {{ selectedPeriod }}.</p>
        {% if nominations %}
            <div class="table-scroll">
                <table class="nomination-table">
                    <thead>
                    <tr>
                        <th scope="col">Solution / nominee</th>
                        <th scope="col">Category</th>
                        <th scope="col">Organization</th>
                        <th scope="col">Country</th>
                        <th scope="col">Nominator</th>
                        <th scope="col">Submitted</th>
                        <th scope="col"><span class="visually-hidden">Open nomination</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for nomination in nominations %}
                        <tr>
                            <td><strong>{{ nomination.solution_name ?: (nomination.nominee_first_name ~ ' ' ~ nomination.nominee_last_name) }}</strong><span>{{ nomination.nominee_first_name }} {{ nomination.nominee_last_name }}</span></td>
                            <td>{% if nomination.category_label %}<span class="category-badge">{{ nomination.category_label }}</span>{% else %}—{% endif %}</td>
                            <td>{{ nomination.nominee_organization }}</td>
                            <td>{{ nomination.nominee_country }}</td>
                            <td>{{ nomination.nominator_first_name ? (nomination.nominator_first_name ~ ' ' ~ nomination.nominator_last_name) : '—' }}</td>
                            <td>{{ nomination.created_at|date('M j, Y') }}<span>{{ nomination.document_count }} document{{ nomination.document_count == 1 ? '' : 's' }}</span></td>
                            <td class="table-action"><a class="text-link" href="{{ site_url('admin/nominations/' ~ nomination.id) }}">Open overview<span class="visually-hidden"> for {{ nomination.nominee_first_name }} {{ nomination.nominee_last_name }}</span></a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <section class="empty-state">
                <h2>No nominations in this award cycle</h2>
                <p>Choose another award cycle to view earlier submissions.</p>
            </section>
        {% endif %}
    {% else %}
        <section class="empty-state">
            <h2>No nominations yet</h2>
            <p>Submitted nominations will appear here for jury members and administrators.</p>
        </section>
    {% endif %}
</div>
{% endblock %}
