{% extends 'layout.html.twig' %}

{% block title %}Users · IFR Robotics Awards{% endblock %}

{% block hero %}
<section class="hero hero-compact">
    <div class="hero-inner">
        <p class="eyebrow">Administration</p>
        <h1>User management</h1>
        <p>Manage access for jury members and administrators. Nominators submit without an account.</p>
    </div>
</section>
{% endblock %}

{% block content %}
<div class="content-shell users-shell">
    {% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
    {% if success %}<p class="notice" role="status">{{ success }}</p>{% endif %}
    <section class="card admin-panel">
        <h2>Users</h2>
        {% if users %}
        <div class="table-scroll">
            <table class="nomination-table users-table">
                <thead><tr><th scope="col">Username</th><th scope="col">Email</th><th scope="col">Roles</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.username ?: '—' }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.getGroups()|join(', ') }}</td>
                        <td>{{ user.active ? 'Active' : 'Inactive' }}</td>
                        <td>
                            <button class="user-actions-trigger" type="button" popovertarget="user-actions-{{ user.id }}" aria-label="Actions for {{ user.username ?: user.email }}" data-user-menu-trigger>
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
                            </button>
                            <div id="user-actions-{{ user.id }}" class="user-actions-menu" popover aria-label="Actions for {{ user.username ?: user.email }}">
                                <a href="{{ site_url('admin/users/' ~ user.id ~ '/edit') }}">Edit</a>
                                {% if user.id != currentUserId %}<a class="user-action-delete" href="{{ site_url('admin/users/' ~ user.id ~ '/delete') }}">Delete</a>{% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}<p>No users yet.</p>{% endif %}
    </section>

    <section class="card admin-panel">
        <h2>{{ editing ? 'Edit user' : 'Add user' }}</h2>
        {% if editing %}<p>Update the username, email address and role. Leave both password fields empty to keep the current password.</p>{% else %}<p>Create a jury or admin account and share the initial password with the user. Users can change their password in their account.</p>{% endif %}
        {% if errors %}
        <div class="form-errors" role="alert"><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>
        {% endif %}
        <form class="user-form" action="{{ site_url(editing ? 'admin/users/' ~ editing.id : 'admin/users') }}" method="post">
            {{ csrf_field() }}
            <div class="field-grid">
                <div class="field">
                    <label for="user-username">Username</label>
                    <input type="text" id="user-username" aria-describedby="user-username-hint" name="username" value="{{ values.username|default('') }}" minlength="3" maxlength="30" pattern="[a-zA-Z0-9.]+" required>
                    <p class="field-hint" id="user-username-hint">3–30 characters: letters, numbers and dots.</p>
                </div>
                <div class="field">
                    <label for="user-email">Email</label>
                    <input id="user-email" name="email" type="email" value="{{ values.email|default('') }}" maxlength="254" required>
                </div>
                <div class="field full">
                    <label for="user-role">Role</label>
                    <select id="user-role" name="role" required>
                        <option value="jury" {{ values.role|default('jury') == 'jury' ? 'selected' : '' }}>Jury — review nominations</option>
                        <option value="admin" {{ values.role|default('jury') == 'admin' ? 'selected' : '' }}>Admin — manage nominations and users</option>
                    </select>
                </div>
                <div class="field">
                    <label for="user-password">{{ editing ? 'New password (optional)' : 'Initial password' }}</label>
                    <input id="user-password" name="password" type="password" autocomplete="new-password" {{ not editing ? 'required' : '' }}>
                </div>
                <div class="field">
                    <label for="user-password-confirm">{{ editing ? 'Confirm new password' : 'Confirm initial password' }}</label>
                    <input id="user-password-confirm" name="password_confirm" type="password" autocomplete="new-password" {{ not editing ? 'required' : '' }}>
                </div>
            </div>
            <div class="user-form-actions">
            <button class="button" type="submit">{{ editing ? 'Save changes' : 'Create user' }}</button>
            {% if editing %}<a class="button secondary" href="{{ site_url('admin/users') }}">Cancel</a>{% endif %}
            </div>
        </form>
    </section>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ site_url('assets/js/user-actions.js') }}?v=20261114-2" defer></script>
{% endblock %}
