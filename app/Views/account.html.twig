{% extends 'layout.html.twig' %}

{% block title %}Account · IFR Robotics Awards{% endblock %}

{% block hero %}
<section class="hero">
    <div class="hero-inner">
        <p class="eyebrow">Account</p>
        <h1>Welcome, {{ username }}</h1>
        <p>You are signed in as {{ email }}.</p>
    </div>
</section>
{% endblock %}

{% block content %}
<div class="content-shell">
    <section class="card">
        <h2>Your award nominations</h2>
        <p>Use your account to submit a candidate for an IFR Robotics Award.</p>
        <a class="button" href="{{ site_url('/') }}">Start nomination</a>

        {% if success %}<p class="notice">{{ success }}</p>{% endif %}
        {% if error %}<p class="notice error">{{ error }}</p>{% endif %}

        <h2>Change password</h2>
        {% if passwordErrors %}
        <div class="form-errors" role="alert">
            <ul>{% for message in passwordErrors %}<li>{{ message }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        <form action="{{ site_url('account/password') }}" method="post">
            {{ csrf_field() }}
            <div class="field-grid">
                <div class="field full">
                    <label for="current-password">Current password</label>
                    <input id="current-password" name="current_password" type="password" autocomplete="current-password" required>
                </div>
                <div class="field">
                    <label for="new-password">New password</label>
                    <input id="new-password" name="password" type="password" autocomplete="new-password" required>
                </div>
                <div class="field">
                    <label for="password-confirm">Confirm new password</label>
                    <input id="password-confirm" name="password_confirm" type="password" autocomplete="new-password" required>
                </div>
            </div>
            <button class="button" type="submit">Change password</button>
        </form>

        <h2>SMTP test</h2>
        <p>Send a test email to your account address. In local development it appears in Mailpit.</p>
        <form action="{{ site_url('account/test-email') }}" method="post">
            {{ csrf_field() }}
            <button class="button secondary" type="submit">Send test email</button>
        </form>
    </section>
</div>
{% endblock %}
